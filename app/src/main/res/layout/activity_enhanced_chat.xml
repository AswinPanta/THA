<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pirate_dark_blue"
    tools:context=".ChatActivity">

    <!-- Main Chat Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/pirate_black"
                app:title="🏴‍☠️ Pirate Chat"
                app:titleTextColor="@color/pirate_gold" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Moderation Warning Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/moderation_warning_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/op_red"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/white"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/moderation_warning_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Message blocked by moderation"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Chat Messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_enhanced_chat_message" />

        <!-- Typing Indicator -->
        <LinearLayout
            android:id="@+id/typing_indicator_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:id="@+id/typing_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Someone is typing..."
                android:textColor="@color/pirate_gray"
                android:textSize="12sp"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- Suggestion Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/suggestion_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:singleLine="true"
                android:visibility="gone" />

        </HorizontalScrollView>

        <!-- Translation Progress -->
        <LinearLayout
            android:id="@+id/translation_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/translation_progress_bar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Translating messages..."
                android:textColor="@color/pirate_gold"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Message Input Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/pirate_black_transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <!-- Translation Toggle -->
                <ImageButton
                    android:id="@+id/translate_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/pirate_gold"
                    android:contentDescription="Toggle Translation" />

                <!-- Suggestions Toggle -->
                <ImageButton
                    android:id="@+id/suggestions_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/pirate_gold"
                    android:contentDescription="Toggle Suggestions" />

                <!-- Message Input -->
                <EditText
                    android:id="@+id/message_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@null"
                    android:hint="Type your message..."
                    android:textColor="@color/white"
                    android:textColorHint="@color/pirate_gray"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:inputType="textMultiLine|textCapSentences" />

                <!-- Send Button -->
                <ImageButton
                    android:id="@+id/send_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_button_background"
                    android:backgroundTint="@color/pirate_gold"
                    android:src="@drawable/ic_send"
                    app:tint="@color/pirate_black"
                    android:contentDescription="Send Message" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Channel Selector FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/channel_selector_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="80dp"
        android:src="@drawable/ic_chat_bubble"
        app:tint="@color/white"
        app:backgroundTint="@color/pirate_red"
        android:contentDescription="Select Channel" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
