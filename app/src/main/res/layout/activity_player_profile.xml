<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pirate_dark_blue"
    tools:context=".PlayerProfileActivity">

    <!-- App Bar Layout -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/pirate_black"
            app:expandedTitleMarginStart="16dp"
            app:expandedTitleMarginEnd="64dp"
            app:title="Player Profile">

            <!-- Profile Banner -->
            <ImageView
                android:id="@+id/profile_banner_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_banner_default"
                android:alpha="0.8"
                app:layout_collapseMode="parallax" />

            <!-- Profile Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                app:layout_collapseMode="parallax">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/profile_avatar_image"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/default_avatar"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/pirate_gold"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Player Name -->
                <TextView
                    android:id="@+id/player_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Captain Blackbeard"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    tools:text="Captain Blackbeard" />

                <!-- Player Title -->
                <TextView
                    android:id="@+id/player_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legendary Pirate"
                    android:textSize="16sp"
                    android:textColor="@color/pirate_gold"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    tools:text="Legendary Pirate" />

                <!-- Level and Score Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/player_level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 42"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/pirate_blue"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"
                        tools:text="Level 42" />

                    <TextView
                        android:id="@+id/total_score_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12,450 points"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/pirate_gold"
                        android:padding="8dp"
                        tools:text="12,450 points" />

                </LinearLayout>

                <!-- Global Rank -->
                <TextView
                    android:id="@+id/global_rank_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Global Rank: #42"
                    android:textSize="12sp"
                    android:textColor="@color/pirate_gray"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    tools:text="Global Rank: #42"
                    tools:visibility="visible" />

                <!-- Join Date and Last Active -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/join_date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Joined Mar 15, 2024"
                        android:textSize="11sp"
                        android:textColor="@color/pirate_gray"
                        android:layout_marginEnd="16dp"
                        tools:text="Joined Mar 15, 2024" />

                    <TextView
                        android:id="@+id/last_active_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last active 2 hours ago"
                        android:textSize="11sp"
                        android:textColor="@color/pirate_gray"
                        tools:text="Last active 2 hours ago" />

                </LinearLayout>

            </LinearLayout>

            <!-- Toolbar -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Level Progress Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/pirate_black_transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Level Progress"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/pirate_gold"
                        android:layout_marginBottom="12dp" />

                    <ProgressBar
                        android:id="@+id/level_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="65"
                        android:progressTint="@color/pirate_gold"
                        android:progressBackgroundTint="@color/pirate_gray"
                        style="?android:attr/progressBarStyleHorizontal"
                        tools:progress="65" />

                    <TextView
                        android:id="@+id/level_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="650 / 1,000 XP"
                        android:textSize="12sp"
                        android:textColor="@color/pirate_gray"
                        android:layout_marginTop="8dp"
                        tools:text="650 / 1,000 XP" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Statistics Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/pirate_black_transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Statistics"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/pirate_gold"
                        android:layout_marginBottom="16dp" />

                    <!-- Statistics Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3">

                        <!-- Treasures Captured -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/treasures_captured_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,234"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="1,234" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Treasures"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Distance Walked -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/distance_walked_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42.5 km"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="42.5 km" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distance"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Time Played -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/time_played_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="156 hours"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="156 hours" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time Played"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Achievements -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/achievements_unlocked_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="28"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="28" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Achievements"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Consecutive Days -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/consecutive_days_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="15" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Day Streak"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Social Interactions -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/social_interactions_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="342"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                tools:text="342" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Messages"
                                android:textSize="12sp"
                                android:textColor="@color/pirate_gray"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </GridLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Badges Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/badges_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/pirate_black_transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏅 Badges"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/pirate_gold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/badges_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Achievements Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/achievements_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/pirate_black_transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 Recent Achievements"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/pirate_gold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/achievements_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Recent Activity Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/recent_activity_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/pirate_black_transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 Recent Activity"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/pirate_gold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recent_activity_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        style="?android:attr/progressBarStyleLarge" />

    <!-- Error Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/error_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/op_red"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_error"
                app:tint="@color/white"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Failed to load player profile"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:gravity="center"
                tools:text="Failed to load player profile" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
